# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is gitignored — never commit real keys.

# --- LLM provider ---
# Anthropic is the default provider in agent.py and pipeline/extraction.py
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — only needed if you switch the provider to "gemini"
# GOOGLE_API_KEY=your-google-key-here

# --- PostgreSQL (pgvector) ---
# These three create the container (docker-compose.yml reads them).
POSTGRES_USER=documents_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=documents

# SQLAlchemy connection string (rag/database.py reads this).
# IMPORTANT: user/password/db must match the three values above,
# and the port must be 5433 (the host port docker-compose.yml maps to).
# Format: postgresql://<user>:<password>@localhost:5433/<db>
DATABASE_URL=postgresql://documents_user:change-me@localhost:5433/documents
